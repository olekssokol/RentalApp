<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Harbor Homes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <header class="site-header">
        <nav class="navbar navbar-expand-md navbar-dark site-nav">
            <div class="container-xl">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M2 13V7.5L8 3l6 4.5V13H10V9H6v4H2Z" fill="currentColor"/>
                        </svg>
                    </span>
                    Harbor Homes
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Applications" ? "active" : null)" asp-controller="Applications" asp-action="Index">Applications</a>
                            </li>
                            @if (User.IsInRole(AppRoles.PropertyManager))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Properties" ? "active" : null)" asp-controller="Properties" asp-action="Index">Properties</a>
                                </li>
                            }
                            @if (User.IsInRole(AppRoles.Applicant))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Units" ? "active" : null)" asp-controller="Units" asp-action="Available">Available units</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-md-center gap-md-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <div class="user-chip me-md-2">
                                    <div>
                                        <div class="user-chip-name">@User.GetDisplayName()</div>
                                        <span class="user-chip-role">@(User.IsManager() ? "Property manager" : "Applicant")</span>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Login" ? "active" : null)" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Register">Sign up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="page-shell">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success flash" data-auto-dismiss role="status">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger flash" data-auto-dismiss role="alert">@error</div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content" id="appModalContent"></div>
        </div>
    </div>

    <footer class="site-footer">
        <div class="container-xl small">Harbor Homes — rental applications for applicants and property managers</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
