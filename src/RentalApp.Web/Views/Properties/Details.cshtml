@model PropertyDetailsViewModel
@{
    ViewData["Title"] = Model.Property.Name;
}

<div class="page-header">
    <div>
        <p class="page-kicker">Property</p>
        <h1>@Model.Property.Name</h1>
        <p class="page-lede">@Model.Property.AddressLine1, @Model.Property.City, @Model.Property.State @Model.Property.PostalCode</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">All properties</a>
        <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("CreateModal", "Units", new { propertyId = Model.Property.Id })">Add unit</button>
    </div>
</div>

<div id="unit-list">
    <partial name="~/Views/Units/Partials/_UnitList.cshtml" model="Model.Units" />
</div>
