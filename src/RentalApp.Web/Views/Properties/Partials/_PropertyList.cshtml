@model IReadOnlyList<PropertyDto>

<div class="page-header">
    <div>
        <p class="page-kicker">Portfolio</p>
        <h1>Properties</h1>
        <p class="page-lede">@(Model.Count == 1 ? "1 building" : $"{Model.Count} buildings") in the catalog.</p>
    </div>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("CreateModal")">Add property</button>
</div>

<div class="app-card p-0 overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <strong>No properties yet</strong>
            Add a building to start creating units.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Property</th>
                        <th>Address</th>
                        <th>Units</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="row-title">@p.Name</td>
                        <td>
                            <span>@p.AddressLine1</span>
                            <span class="row-sub">@p.City, @p.State @p.PostalCode</span>
                        </td>
                        <td>@p.UnitCount</td>
                        <td>
                            <div class="table-actions">
                                <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@p.Id">Manage</a>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("EditModal", new { id = p.Id })">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("DeleteModal", new { id = p.Id })">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
