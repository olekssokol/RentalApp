@model ApplicationListViewModel
@{
    ViewData["Title"] = "Applications";
    var grid = new ApplicationGridViewModel
    {
        Status = Model.Status,
        PropertyId = Model.PropertyId,
        Page = Model.Page,
        PageSize = Model.PageSize,
        Sort = Model.Sort,
        Direction = Model.Direction,
        IsManager = Model.IsManager
    };
}

<div class="page-header">
    <div>
        <p class="page-kicker">@(Model.IsManager ? "Inbox" : "Your files")</p>
        <h1>Applications</h1>
        <p class="page-lede">@(Model.IsManager ? "Filter the queue, open a file, or review a submitted application." : "Track drafts, returns, and decisions in one list.")</p>
    </div>
</div>

<form method="get" class="app-card mb-3" data-application-grid-filters>
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="status">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (ApplicationStatus s in Enum.GetValues<ApplicationStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="propertyId">Property</label>
            <select id="propertyId" name="propertyId" class="form-select">
                <option value="">All properties</option>
                @foreach (var p in Model.Properties)
                {
                    <option value="@p.Value" selected="@(Model.PropertyId?.ToString() == p.Value)">@p.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="pageSize">Rows</label>
            <select id="pageSize" name="pageSize" class="form-select">
                @foreach (var size in new[] { 10, 20, 50 })
                {
                    <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

@await Component.InvokeAsync("ApplicationGrid", new { model = grid })
