@model ApplicationWizardViewModel

<section class="summary-block summary-block-full mt-3">
    <h3>Applicants</h3>
    <ul class="member-list">
        @foreach (var member in Model.Members)
        {
            <li class="member-row">
                <div class="member-identity">
                    <span class="row-title">@member.DisplayName</span>
                    @if (member.IsCreator)
                    {
                        <span class="pill pill-muted">Creator</span>
                    }
                </div>
                @if (Model.CanEdit && !member.IsCreator)
                {
                    <form asp-action="RemoveCoApplicant" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="userId" value="@member.UserId" />
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">Remove</button>
                    </form>
                }
            </li>
        }
    </ul>
    @if (Model.CanEdit)
    {
        <form asp-action="AddCoApplicant" method="post" class="member-add row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-md-7">
                <label class="form-label" for="coApplicantEmail">Add co-applicant by email</label>
                <input id="coApplicantEmail" name="email" class="form-control" type="email" asp-for="CoApplicantEmail" placeholder="applicant@rental.local" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Add</button>
            </div>
        </form>
    }
</section>
