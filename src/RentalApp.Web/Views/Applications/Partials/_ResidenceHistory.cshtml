@model ApplicationWizardViewModel

<div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
    <div>
        <h2 class="h5 mb-1">Residence history</h2>
        <p class="page-lede mb-0">Previous addresses help the manager complete a review.</p>
    </div>
    @if (Model.CanEdit)
    {
        <button type="button" class="btn btn-sm btn-primary" data-modal-url="@Url.Action("ResidenceModal", new { applicationId = Model.Id })">Add residence</button>
    }
</div>

@if (Model.Residences.Count == 0)
{
    <div class="empty-state py-4">
        <strong>No residences yet</strong>
        @(Model.CanEdit ? "Add at least one address before you continue." : "None on file.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Address</th>
                    <th>Landlord</th>
                    <th>Phone</th>
                    <th>Move-in</th>
                    <th>Move-out</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Residences)
            {
                <tr>
                    <td class="row-title">@r.Address</td>
                    <td>@r.LandlordName</td>
                    <td>@r.LandlordPhone</td>
                    <td>@r.MoveInDate</td>
                    <td>@(r.MoveOutDate?.ToString() ?? "Present")</td>
                    <td>
                        @if (Model.CanEdit)
                        {
                            <div class="table-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("ResidenceModal", new { applicationId = Model.Id, id = r.Id })">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("DeleteResidenceModal", new { applicationId = Model.Id, id = r.Id })">Remove</button>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
