@model ApplicationWizardViewModel

<div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
    <div>
        <h2 class="h5 mb-1">Residence history</h2>
        <p class="page-lede mb-0">Previous addresses help the manager complete a review.</p>
    </div>
    @if (Model.CanEdit)
    {
        <button type="button" class="btn btn-sm btn-primary" data-modal-url="@Url.Action("ResidenceModal", new { applicationId = Model.Id })">Add residence</button>
    }
</div>

@if (ViewData.ModelState["Residences"]?.Errors.Count > 0)
{
    <div class="text-danger mb-3">@ViewData.ModelState["Residences"]!.Errors.First().ErrorMessage</div>
}

@if (Model.Residences.Count == 0)
{
    <div class="empty-state py-4">
        <strong>No residences yet</strong>
        @(Model.CanEdit ? "Add at least one address before you continue." : "None on file.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Address</th>
                    <th>Landlord</th>
                    <th>Phone</th>
                    <th>Move-in</th>
                    <th>Move-out</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @{
                var index = 0;
            }
            @foreach (var r in Model.Residences)
            {
                var rowPrefix = $"Residences[{index}]";
                var hasRowErrors = ViewData.ModelState.Keys.Any(k => k.StartsWith(rowPrefix + ".", StringComparison.Ordinal));
                <tr class="@(hasRowErrors ? "table-warning" : null)">
                    <td class="row-title">
                        @(r.Address ?? "—")
                        @foreach (var err in ViewData.ModelState[$"{rowPrefix}.Address"]?.Errors ?? [])
                        {
                            <span class="d-block text-danger small">@err.ErrorMessage</span>
                        }
                    </td>
                    <td>
                        @(r.LandlordName ?? "—")
                        @foreach (var err in ViewData.ModelState[$"{rowPrefix}.LandlordName"]?.Errors ?? [])
                        {
                            <span class="d-block text-danger small">@err.ErrorMessage</span>
                        }
                    </td>
                    <td>
                        @(r.LandlordPhone ?? "—")
                        @foreach (var err in ViewData.ModelState[$"{rowPrefix}.LandlordPhone"]?.Errors ?? [])
                        {
                            <span class="d-block text-danger small">@err.ErrorMessage</span>
                        }
                    </td>
                    <td>
                        @(r.MoveInDate?.ToString() ?? "—")
                        @foreach (var err in ViewData.ModelState[$"{rowPrefix}.MoveInDate"]?.Errors ?? [])
                        {
                            <span class="d-block text-danger small">@err.ErrorMessage</span>
                        }
                    </td>
                    <td>
                        @(r.MoveOutDate?.ToString() ?? "Present")
                        @foreach (var err in ViewData.ModelState[$"{rowPrefix}.MoveOutDate"]?.Errors ?? [])
                        {
                            <span class="d-block text-danger small">@err.ErrorMessage</span>
                        }
                    </td>
                    <td>
                        @if (Model.CanEdit)
                        {
                            <div class="table-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("ResidenceModal", new { applicationId = Model.Id, id = r.Id })">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("DeleteResidenceModal", new { applicationId = Model.Id, id = r.Id })">Remove</button>
                            </div>
                        }
                    </td>
                </tr>
                index++;
            }
            </tbody>
        </table>
    </div>
}
