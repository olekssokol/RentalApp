@model ApplicationWizardViewModel
@{
    var readOnly = !Model.CanEdit;
}

<h2 class="h5 mb-1">Applicant information</h2>
<p class="page-lede mb-3">How we should reach you about this unit.</p>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="FullName" class="form-label"></label>
        @if (readOnly)
        {
            <input asp-for="FullName" class="form-control" readonly />
        }
        else
        {
            <input asp-for="FullName" class="form-control" />
        }
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Phone" class="form-label"></label>
        @if (readOnly)
        {
            <input asp-for="Phone" class="form-control" readonly />
        }
        else
        {
            <input asp-for="Phone" class="form-control" />
        }
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Email" class="form-label"></label>
        @if (readOnly)
        {
            <input asp-for="Email" class="form-control" readonly />
        }
        else
        {
            <input asp-for="Email" class="form-control" />
        }
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-12 mb-0">
        <label asp-for="CurrentAddress" class="form-label"></label>
        @if (readOnly)
        {
            <textarea asp-for="CurrentAddress" class="form-control" rows="2" readonly></textarea>
        }
        else
        {
            <textarea asp-for="CurrentAddress" class="form-control" rows="2"></textarea>
        }
        <span asp-validation-for="CurrentAddress" class="text-danger"></span>
    </div>
</div>
