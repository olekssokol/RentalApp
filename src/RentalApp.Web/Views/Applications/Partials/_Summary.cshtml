@model ApplicationWizardViewModel

<h2 class="h5 mb-1">Summary</h2>
<p class="page-lede mb-3">Confirm everything before you submit. You can still go back if something is missing.</p>

@if (Model.SubmissionBlockers.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <strong>Submission blocked</strong>
        <p class="mb-2">Fix the items below before you can submit.</p>
        @foreach (var group in Model.SubmissionBlockers.GroupBy(b => b.Section))
        {
            <div class="mb-2">
                <div class="fw-semibold">
                    @(group.Key == ApplicationWizardSection.ApplicantInfo ? "Applicant information" : "Residence history")
                    <a class="ms-2 fw-normal" asp-action="Wizard" asp-route-id="@Model.Id" asp-route-section="@group.Key">@(Model.CanEdit ? "Fix section" : "View section")</a>
                </div>
                <ul class="mb-0 ps-3">
                    @foreach (var blocker in group)
                    {
                        <li>@blocker.Field: @blocker.Message</li>
                    }
                </ul>
            </div>
        }
    </div>
}

<section class="mb-4">
    <h3 class="h6">Applicants on this application</h3>
    <ul class="mb-2 ps-3">
        @foreach (var member in Model.Members)
        {
            <li class="mb-1">
                @member.DisplayName
                @if (member.IsCreator)
                {
                    <span class="text-muted">(creator)</span>
                }
                @if (Model.CanEdit && !member.IsCreator)
                {
                    <form asp-action="RemoveCoApplicant" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="userId" value="@member.UserId" />
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0 align-baseline">Remove</button>
                    </form>
                }
            </li>
        }
    </ul>
    @if (Model.CanEdit)
    {
        <form asp-action="AddCoApplicant" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-md-6">
                <label class="form-label" for="coApplicantEmail">Add co-applicant by email</label>
                <input id="coApplicantEmail" name="email" class="form-control" type="email" asp-for="CoApplicantEmail" placeholder="applicant@rental.local" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Add</button>
            </div>
        </form>
    }
</section>

<div class="summary-grid">
    <section class="summary-block">
        <h3>Applicant</h3>
        <dl>
            <dt>Name</dt><dd>@(Model.FullName ?? "—")</dd>
            <dt>Phone</dt><dd>@(Model.Phone ?? "—")</dd>
            <dt>Email</dt><dd>@(Model.Email ?? "—")</dd>
            <dt>Address</dt><dd class="mb-0">@(Model.CurrentAddress ?? "—")</dd>
        </dl>
    </section>
    <section class="summary-block">
        <h3>Residences</h3>
        @if (Model.Residences.Count == 0)
        {
            <p class="mb-0 text-muted">None added.</p>
        }
        else
        {
            <ul class="mb-0 ps-3">
                @foreach (var r in Model.Residences)
                {
                    <li class="mb-2">
                        <span class="row-title">@(r.Address ?? "—")</span>
                        <span class="row-sub">@(r.LandlordName ?? "—") · @(r.MoveInDate?.ToString() ?? "—") – @(r.MoveOutDate?.ToString() ?? "present")</span>
                        <span class="row-sub">Landlord phone: @(r.LandlordPhone ?? "—")</span>
                    </li>
                }
            </ul>
        }
    </section>
</div>
